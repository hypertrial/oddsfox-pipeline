# OddsFox v0.1.x local environment.
# Copy to `.env` for local overrides.

DUCKDB_NAME=oddsfox.duckdb
# DUCKDB_PATH takes precedence over DUCKDB_NAME. Use an SSD path for hosted runs.
# DUCKDB_PATH=/absolute/path/to/OddsFox/.runtime/warehouse/oddsfox.duckdb
# DBT_PROFILES_DIR=/absolute/path/to/dbt/profiles

# Live API pacing.
MARKETS_REQUESTS_PER_SECOND=10
ODDS_REQUESTS_PER_SECOND=40
KALSHI_REQUESTS_PER_SECOND=5
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=60

# Unscheduled hosted PMXT historical L2 order-book backfill. The key is sent
# only as a Bearer token and is never logged or persisted.
# PMXT_API_KEY=

# Unscheduled WC2026 Polygon settlement history. Use a Polygon archive-capable
# endpoint for seed authoring; the historical fill backfill requires finalized
# block/log access. Endpoint values are secrets and are never persisted or logged.
# The Make target roots its v4 warehouse, status, Dagster/dbt state, temp files,
# and caches below this SSD-backed checkout's `.cache/polygon_settlement/`.
# POLYGON_RPC_URL=https://polygon-rpc.example/v1/secret-token
# POLYGON_RPC_PROVIDER_LABEL=provider-and-plan-name

# Optional independent verification provider. Missing, disagreeing, or failed
# verification is reported as an advisory warning and does not block release.
# POLYGON_VERIFY_RPC_URL=https://second-polygon-rpc.example/v1/secret-token
# POLYGON_VERIFY_RPC_PROVIDER_LABEL=second-provider-and-plan-name

# Optional WC2026 scope-discovery overrides. Leave unset for the bundled preset.
# POLYMARKET_WC2026_SCOPE_EVENT_SLUGS=2026-fifa-world-cup-winner
# POLYMARKET_WC2026_SCOPE_EVENT_SLUG_PREFIXES=2026-fifa-world-cup
# POLYMARKET_WC2026_SCOPE_EVENT_TAGS=2026-fifa-world-cup,fifa-world-cup,world-cup
# POLYMARKET_WC2026_SCOPE_REGISTRY_MAX_EVENT_PAGES=
# POLYMARKET_WC2026_SCOPE_KEYSET_CLOSED=false
# POLYMARKET_WC2026_SCOPE_KEYSET_VOLUME_MIN=
# POLYMARKET_WC2026_SCOPE_KEYSET_RELATED_TAGS=true
# POLYMARKET_WC2026_SCOPE_TAG_DISCOVERY=true
# POLYMARKET_WC2026_SCOPE_TAG_CLOSURE_ROUNDS=2
# POLYMARKET_WC2026_SCOPE_TAG_CRAWL_MAX=100
# POLYMARKET_WC2026_SCOPE_TAG_DISCOVERY_KEYWORDS=world cup,world-cup,fifa,world-cup-2026,fifa-world-cup,wc-2026,world-cup-qualifier,world-cup-qualifiers
# POLYMARKET_WC2026_SCOPE_TAG_CLOSURE_KEYWORD_GATE=true
# POLYMARKET_WC2026_SCOPE_TAG_CRAWL_DENYLIST=sports,soccer,football,politics,pop-culture,crypto,business,economy,world,games

# Schedules are opt-in. Leave disabled in local dev and CI unless intentionally running live ingestion.
KALSHI_WC2026_HOURLY_ODDS_SCHEDULE_ENABLED=false
POLYMARKET_SOCCER_DAILY_SCHEDULE_ENABLED=false

# Unified minute-odds backfill. Defaults true (refresh each leg). Set false after
# a successful land to skip that leg on reruns; restart `uv run make dagster-dev`
# after changing. Both match and futures may be false for a dbt-only rebuild.
# POLYMARKET_WC2026_MINUTE_ODDS_REFRESH_CATALOG=true
# POLYMARKET_WC2026_MINUTE_ODDS_REFRESH_MATCH=true
# POLYMARKET_WC2026_MINUTE_ODDS_REFRESH_FUTURES=true
# ODDSFOX_MINUTE_PUBLISH_MEMORY_LIMIT=12GB
# ODDSFOX_MINUTE_PUBLISH_THREADS=
# Force dagster-dev to re-run dbt deps/parse even when manifest.json is fresh.
# ODDSFOX_DBT_FORCE_PREPARE=false
# Live smoke defaults for `make minute-odds-live-smoke` only.
# POLYMARKET_WC2026_MINUTE_ODDS_SMOKE_FRACTION=0.05
# POLYMARKET_WC2026_MINUTE_ODDS_SMOKE_SEED=wc2026-minute-smoke-v1
# POLYMARKET_WC2026_MINUTE_ODDS_SMOKE_FUTURES_WINDOW_HOURS=24
# Warm smoke rerun: MINUTE_ODDS_LIVE_SMOKE_RESET=false MINUTE_ODDS_LIVE_SMOKE_REFRESH_CATALOG=false
# (Make defaults catalog refresh true so cold smoke ignores a false catalog flag in .env.)
